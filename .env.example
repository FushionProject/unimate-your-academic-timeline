# Browser-safe Supabase configuration. The publishable key is intentionally
# client-visible; never place a service-role or secret key in a VITE_* value.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public origin used by the unpacked Browser Companion during configuration.
VITE_UNIMATE_API_URL=http://localhost:8080

# Server-only AI/search credentials. Configure these as encrypted deployment
# secrets in production, not as browser-exposed VITE_* values.
GROQ_API_KEY=
SERPAPI_KEY=
# Operational overrides allow model migration without a code deployment.
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# AI launch controls. Durable quotas are intentionally off until the reviewed
# SUPABASE_USAGE_MIGRATION.sql has been applied and verified in staging.
AI_DURABLE_QUOTAS_ENABLED=false
AI_SYSTEM_MODE=normal
AI_TEXT_PROVIDER=groq
AI_GLOBAL_DAILY_REQUEST_LIMIT=50000
AI_FREE_ASK_DAILY_LIMIT=20
AI_FREE_ASK_MONTHLY_LIMIT=300
AI_PRO_ASK_DAILY_LIMIT=100
AI_PRO_ASK_MONTHLY_LIMIT=2000
# The current product still requires Pro for the Companion. These Free limits
# are ready for a future policy change but do not bypass that entitlement gate.
AI_FREE_COMPANION_DAILY_LIMIT=0
AI_FREE_COMPANION_MONTHLY_LIMIT=0
AI_PRO_COMPANION_DAILY_LIMIT=100
AI_PRO_COMPANION_MONTHLY_LIMIT=2000
AI_WEB_SEARCH_ENABLED=true
AI_SCREENSHOT_ENABLED=true
AI_RELATED_CONCEPTS_ENABLED=true
AI_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
AI_PROVIDER_ERROR_THRESHOLD=5
AI_PROVIDER_COOLDOWN_SECONDS=60
# Supabase Auth UUIDs only; never emails. Overrides remain accounted for but
# bypass per-account limits. They do not bypass the global ceiling or circuit.
AI_QUOTA_OVERRIDE_USER_IDS=
AI_USAGE_ADMIN_USER_IDS=
# Long random server-only value used to pseudonymize high-usage account IDs.
AI_USAGE_HASH_SECRET=

# Server-only Stripe test-mode configuration. Do not add live credentials until
# the separate billing launch gate is explicitly approved.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only Companion diagnostics. Leave false for release packages.
VITE_COMPANION_DEBUG=false
